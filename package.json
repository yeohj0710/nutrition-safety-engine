{
  "name": "nutrition-safety-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:evidence": "python -m tools.build.build_site all",
    "build:consult": "python scripts/build-consult-sources.py",
    "validate:evidence": "python -m tools.build.build_site verify",
    "check:screening-invariants": "python ../evidence-recollect/reproduce.py verify yeo",
    "check:screening-regression": "python -m unittest discover -s ../evidence-recollect/tests -t ../evidence-recollect",
    "build:local-only-manifest": "python ../evidence-recollect/reproduce.py manifest yeo",
    "validate:research": "python ../evidence-recollect/reproduce.py verify yeo"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.25"
  }
}
