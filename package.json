{
  "name": "nutrition-safety-engine",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:legacy": "tsx scripts/build-knowledge-index.ts && tsx scripts/build-literature-candidates.ts",
    "prepare:thesis": "tsx scripts/build-thesis-bundle.ts",
    "prepare:knowledge": "npm run prepare:legacy && npm run prepare:thesis",
    "dev": "tsx scripts/dev-with-knowledge-watch.ts",
    "build": "npm run prepare:knowledge && next build",
    "start": "next start",
    "lint": "npm run prepare:knowledge && eslint .",
    "test": "npm run prepare:knowledge && vitest run",
    "test:unit": "npm run prepare:knowledge && vitest run __tests__/knowledge-normalize.test.ts __tests__/safety-engine.test.ts",
    "test:contract": "npm run prepare:knowledge && vitest run __tests__/thesis-mode-boundary.test.ts __tests__/legacy-mode-boundary.test.ts",
    "test:provenance": "npm run prepare:knowledge && vitest run __tests__/thesis-bundle-isolation.test.ts",
    "test:scenarios:smoke": "npm run prepare:knowledge && vitest run __tests__/thesis-empty-scenario-proxy.test.ts",
    "validate:phase07:proxy": "npm run prepare:thesis && tsx scripts/run-phase07-safe-empty-proxy.ts && python tools/validate_phase07_gate.py",
    "validate:phase08:checkpoint": "python tools/generate_checkpoint_manifest.py && python tools/validate_phase08_checkpoint.py",
    "validate:pmc-locators": "python tools/validate_pmc_fulltext_candidates.py",
    "validate:central-hitcounts": "python tools/validate_central_hitcount_observations.py",
    "validate:koreamed": "python tools/validate_koreamed_designpilot.py",
    "capture:korean-db-split-pilot": "node tools/capture_korean_db_split_pilot.mjs",
    "validate:korean-db-split-pilot": "python tools/validate_korean_db_split_pilot.py",
    "typecheck": "npm run prepare:knowledge && tsc --noEmit"
  },
  "dependencies": {
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
