# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.venv/
/.npm-cache/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
__pycache__/
.pytest_cache/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next-*.log
tmp-next-dev.*.log
codex-start-*.log
.playwright-cli/
output/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# search pipeline local browser session
data/systematic_search/.browser/

# local-only research documents and restricted full texts
research/design/20260710/00_AUDIT/reference_inputs/*.pdf
research/full_texts/
data/full_texts/

# large/copyright-sensitive public search payloads stay local; hashes and metadata are tracked
research/searches/*/pubmed/*/efetch_*.xml
data/interim/records.csv

# Claude Code local tooling config
/.claude/

# v4.0 large payloads stay local; hashes and metadata are tracked.
# Inventory with sizes and SHA-256: research/logs/v40_local_only_manifest.json
#   - efetch XML: same volume/copyright reason as research/searches/ above (1.1 GB)
#   - evidence_map.csv: 114.5 MiB, over GitHub's 100 MiB per-file hard limit.
#     Rebuildable from the efetch XML; hash in data/curated_v4/corpus_manifest.json.
#   - v40_agent/batches/: screening inputs, reproducible from evidence_map.csv +
#     batch_index.json, which carries input_sha256 for all 196 batches.
#   - etc/failed_classifier_*/: discarded classifier generations kept as local
#     evidence of the rejection process; hashes tracked in the manifest.
research/searches_v4/*/pubmed/*/efetch_*.xml
data/curated_v4/evidence_map.csv
research/screening/v40_agent/batches/
research/screening/v40_agent/etc/failed_classifier_*/
