{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/llm-evidence-extraction.schema.json",
  "title": "LLM Evidence Extraction Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "report_id",
    "question_id",
    "model",
    "fields",
    "warnings"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "question_id": {
      "type": "string",
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "B3"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version_or_access_date",
        "temperature",
        "prompt_sha256"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "version_or_access_date": {
          "type": "string"
        },
        "temperature": {
          "type": [
            "number",
            "null"
          ]
        },
        "prompt_sha256": {
          "type": "string"
        }
      }
    },
    "fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field_name",
          "value",
          "status",
          "supporting_quote",
          "locator",
          "confidence",
          "reasoning_note"
        ],
        "properties": {
          "field_name": {
            "type": "string"
          },
          "value": {},
          "normalized_value": {},
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "extracted",
              "not_reported",
              "unclear",
              "not_applicable"
            ]
          },
          "supporting_quote": {
            "type": [
              "string",
              "null"
            ]
          },
          "locator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "page",
              "section",
              "table_or_figure",
              "source_path",
              "source_file_sha256",
              "xml_locator",
              "paragraph_text_sha256"
            ],
            "anyOf": [
              {
                "properties": {
                  "page": {
                    "type": ["string", "integer"]
                  }
                }
              },
              {
                "properties": {
                  "xml_locator": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ],
            "properties": {
              "page": {
                "type": [
                  "string",
                  "integer",
                  "null"
                ]
              },
              "section": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "table_or_figure": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?!.*legacy_unverified).+$"
              },
              "source_file_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "xml_locator": {
                "type": ["string", "null"]
              },
              "paragraph_text_sha256": {
                "type": ["string", "null"],
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "reasoning_note": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {"const": "extracted"}
              },
              "required": ["status"]
            },
            "then": {
              "properties": {
                "supporting_quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "input_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "output_sha256": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
