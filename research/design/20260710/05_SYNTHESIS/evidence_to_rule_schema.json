{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/evidence-to-rule.schema.json",
  "title": "Evidence Claim and Deterministic Rule Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_version",
    "contract_mode",
    "certainty_assessments",
    "claims",
    "rules"
  ],
  "properties": {
    "bundle_version": {
      "type": "string"
    },
    "contract_mode": {
      "type": "string",
      "enum": ["production", "synthetic_contract_fixture"]
    },
    "certainty_assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["certainty_assessment_id", "question_id", "certainty", "verification_status"],
        "properties": {
          "certainty_assessment_id": {"type": "string", "minLength": 1},
          "question_id": {"type": "string", "enum": ["A1", "A2", "B1", "B2", "B3"]},
          "certainty": {"type": "string", "enum": ["high", "moderate", "low", "very_low"]},
          "verification_status": {"type": "string", "enum": ["draft", "validated"]},
          "verified_by": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "question_id",
          "claim_text",
          "scope_status",
          "population",
          "exposure",
          "outcome",
          "evidence_layer",
          "certainty",
          "certainty_assessment_id",
          "support",
          "verification_status"
        ],
        "properties": {
          "claim_id": {
            "type": "string",
            "pattern": "^CLM-"
          },
          "question_id": {
            "type": "string",
            "enum": [
              "A1",
              "A2",
              "B1",
              "B2",
              "B3"
            ]
          },
          "claim_text": {
            "type": "string",
            "minLength": 10
          },
          "scope_status": {
            "type": "string",
            "enum": ["validated_thesis_scope", "exploratory_demo", "legacy_unverified", "retired"]
          },
          "population": {
            "type": "object"
          },
          "exposure": {
            "type": "object"
          },
          "comparator": {
            "type": [
              "object",
              "null"
            ]
          },
          "outcome": {
            "type": "object"
          },
          "effect": {
            "type": [
              "object",
              "null"
            ]
          },
          "evidence_layer": {
            "type": "string",
            "enum": [
              "primary_synthesis",
              "secondary_context",
              "guidance",
              "safety_signal"
            ]
          },
          "certainty": {
            "type": "string",
            "enum": [
              "high",
              "moderate",
              "low",
              "very_low",
              "not_graded"
            ]
          },
          "certainty_assessment_id": {
            "type": "string",
            "minLength": 1
          },
          "applicability_notes": {
            "type": "string"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "support": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "report_id",
                "extraction_id",
                "source_path",
                "source_file_sha256",
                "locator",
                "locator_text_sha256",
                "supporting_quote",
                "supporting_quote_sha256",
                "human_verified_by"
              ],
              "properties": {
                "source_id": {
                  "type": "string"
                },
                "report_id": {
                  "type": "string"
                },
                "extraction_id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_path": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!.*legacy_unverified).+$"
                },
                "source_file_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "study_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "locator_text_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "supporting_quote": {
                  "type": "string",
                  "minLength": 1
                },
                "supporting_quote_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "human_verified_by": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1}
                }
              }
            }
          },
          "verification_status": {
            "type": "string",
            "enum": [
              "draft",
              "human_verified",
              "validated",
              "retired"
            ]
          },
          "verified_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "version": {
            "type": "string"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"verification_status": {"const": "validated"}},
              "required": ["verification_status"]
            },
            "then": {
              "required": ["verified_by"],
              "properties": {
                "verified_by": {"minItems": 1, "uniqueItems": true}
              }
            }
          }
        ]
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "question_id",
          "scope_status",
          "conditions",
          "action_class",
          "message_template",
          "claim_ids",
          "validation_status",
          "version"
        ],
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^RUL-"
          },
          "question_id": {
            "type": "string",
            "enum": [
              "A1",
              "A2",
              "B1",
              "B2",
              "B3"
            ]
          },
          "scope_status": {
            "type": "string",
            "enum": [
              "validated_thesis_scope",
              "exploratory_demo",
              "legacy_unverified",
              "retired"
            ]
          },
          "conditions": {
            "type": "object"
          },
          "exclusions": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "missing_information": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "action_class": {
            "type": "string",
            "enum": [
              "urgent_referral",
              "avoid_until_review",
              "pharmacist_review",
              "monitor_or_consistency",
              "information_only",
              "insufficient_evidence"
            ]
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "moderate",
              "low",
              "informational"
            ]
          },
          "message_template": {
            "type": "string",
            "minLength": 10
          },
          "rationale_template": {
            "type": "string"
          },
          "claim_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^CLM-"
            }
          },
          "validation_status": {
            "type": "string",
            "enum": [
              "draft",
              "source_verified",
              "expert_reviewed",
              "scenario_validated",
              "validated",
              "retired"
            ]
          },
          "validation_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "version": {
            "type": "string"
          },
          "effective_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "review_due": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {"scope_status": {"const": "validated_thesis_scope"}},
              "required": ["scope_status"]
            },
            "then": {
              "properties": {
                "validation_status": {"const": "validated"},
                "validation_evidence": {"minItems": 2, "uniqueItems": true}
              },
              "required": ["validation_evidence"]
            }
          }
        ]
      }
    }
  }
}
